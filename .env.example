# 复制为 .env 后填写；.env 已被 .gitignore 排除，绝不提交

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=readonly
NEO4J_PASSWORD=

# LLM（OpenAI 兼容接口）
LLM_PROVIDER=deepseek            # deepseek | qwen | mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=
LLM_TEMPERATURE=0
MOCK_LLM_URL=http://localhost:9000/v1

# 服务地址
AI_SERVICE_URL=http://localhost:8001
GATEWAY_PORT=8000
